[292.358977, "o", "\r\n\u001b[?2004l\r"]
[292.424003, "o", "\u001b[0m\u001b[1mOpenTofu initialized in an empty directory!\u001b[0m\r\n\r\nThe directory has no OpenTofu configuration files. You may begin working\r\nwith OpenTofu immediately by creating OpenTofu configuration files.\u001b[0m\r\n"]
[292.47007, "o", "\u001b[31m╷\u001b[0m\u001b[0m\r\n\u001b[31m│\u001b[0m \u001b[0m\u001b[1m\u001b[31mError: \u001b[0m\u001b[0m\u001b[1mNo configuration files\u001b[0m\r\n\u001b[31m│\u001b[0m \u001b[0m\r\n\u001b[31m│\u001b[0m \u001b[0m\u001b[0mPlan requires configuration to be present. Planning without a configuration would mark everything for destruction,\r\n\u001b[31m│\u001b[0m \u001b[0mwhich is normally not what is desired. If you would like to destroy everything, run plan with the -destroy option.\r\n\u001b[31m│\u001b[0m \u001b[0mOtherwise, create a OpenTofu configuration file (.tf file) and try again.\r\n\u001b[31m╵\u001b[0m\u001b[0m\r\n"]
